{
  "name": "naillies-precommande",
  "version": "1.0.0",
  "private": true,
  "description": "Site de précommande du kit de Noël Naillies, paiement par Stripe Checkout.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "verifier": "node scripts/check.js",
    "build:scene": "esbuild src/scene/main.js --bundle --minify --format=esm --target=es2020 --outfile=public/js/scene.js"
  },
  "dependencies": {
    "stripe": "^23.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "three": "^0.187.0"
  }
}
