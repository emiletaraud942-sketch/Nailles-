# Copier ce fichier en ".env" (jamais commité) puis remplir.

# Clé SECRÈTE Stripe : Stripe > Développeurs > Clés API.
# sk_test_... pour essayer sans argent réel, sk_live_... pour encaisser pour de vrai.
STRIPE_SECRET_KEY=

# Adresse publique du site, sans "/" final. Recommandé en production.
# Exemple : https://www.naillies.fr  (en local, laisser vide)
SITE_URL=

# Port du serveur local (facultatif)
PORT=3000
